NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role (server-only — webhooks, admin). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider — leave unset or set PAYMENT_PROVIDER=sandbox for test mode.
# For South African launch use Paystack (test keys first).
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_MODE=test

# Web Push — opt-in UI stays hidden and subscribe/send no-op until BOTH
# public and private keys are set. Generate with: npx web-push generate-vapid-keys
# Public key may be duplicated as NEXT_PUBLIC_VAPID_PUBLIC_KEY (browser subscribe)
# and VAPID_PUBLIC_KEY (server). Private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URI for VAPID JWT (mailto: or https:).
VAPID_SUBJECT=mailto:appinnovationmc@gmail.com
