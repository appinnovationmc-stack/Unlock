# =============================================================================
# PUBLIC — safe for the browser / Next.js client bundle.
# Only NEXT_PUBLIC_* keys are inlined into client JS.
# Never prefix service role, VAPID private, or payment secrets with NEXT_PUBLIC_.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web Push applicationServerKey (public). Leave empty to hide PushOptIn.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =============================================================================
# SERVER SECRET — never NEXT_PUBLIC_. Never import from client components.
# =============================================================================

# Service role (server-only — webhooks, admin). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push send key (pairs with NEXT_PUBLIC_VAPID_PUBLIC_KEY). Server-only.
# Do not name this NEXT_PUBLIC_VAPID_PRIVATE_KEY.
VAPID_PRIVATE_KEY=

# Payment provider — leave unset or set PAYMENT_PROVIDER=sandbox for test mode.
# For South African launch use Paystack (test keys first).
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=
# Public Paystack key is still a server env name so Next does not bundle it.
# Do not rename to NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY unless adding Inline JS.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional alias for /api/payments/webhook if PAYSTACK_WEBHOOK_SECRET is unset.
PAYMENT_WEBHOOK_SECRET=
PAYSTACK_MODE=test
