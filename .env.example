# =============================================================================
# PUBLIC — safe for the browser / Next.js client bundle.
# Only NEXT_PUBLIC_* keys are inlined into client JS.
# Never prefix service role, VAPID private, or payment secrets with NEXT_PUBLIC_.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web Push applicationServerKey (public). Leave empty to hide PushOptIn.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Carto basemaps (paper field). Request at https://carto.com/basemaps/apikey/
# or email support-basemaps@carto.com. Without this, Explore uses Esri Light Gray.
NEXT_PUBLIC_CARTO_KEY=

# =============================================================================
# SERVER SECRET — never NEXT_PUBLIC_. Never import from client components.
# =============================================================================

SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYSTACK_MODE=test
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:appinnovationmc@gmail.com
